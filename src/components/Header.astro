---
import { site, links } from "../data/site";
---

<header class="wrap site-header">
  <img src="/logo.svg" alt={site.name} width="64" height="64" />
  <a class="btn btn--yellow btn--small" href={links.discord}>
    Join the Discord
  </a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }
  img {
    width: 64px;
    height: 64px;
  }
</style>
