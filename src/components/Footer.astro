---
import { site, links } from "../data/site";
---

<footer>
  <div class="wrap">
    <span>{site.name}</span>
    <nav aria-label="Elsewhere">
      <a href={links.discord}>Discord</a>
      <a href={links.facebook}>Facebook</a>
      <a href={links.patreon}>Patreon</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: var(--cable);
    padding-block: 1.5rem;
    font-size: 0.95rem;
  }
  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
</style>
