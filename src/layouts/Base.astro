---
// The page shell: <head>, fonts and global styles. Every page renders inside this.
import "@fontsource/lilita-one/400.css";
import "@fontsource/atkinson-hyperlegible/400.css";
import "../styles/tokens.css";
import "../styles/global.css";
import StructuredData from "../components/StructuredData.astro";
import { site } from "../data/site";

// Preloaded so the headline and body text don't flash in a fallback font.
import lilitaLatin from "@fontsource/lilita-one/files/lilita-one-latin-400-normal.woff2?url";
import atkinsonLatin from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url";
// The only Japanese text styled in Dela Gothic One is つづく, which lives in this one
// 13KB kana chunk, so the face is declared with just that file rather than the full set.
import delaKana from "@fontsource/dela-gothic-one/files/dela-gothic-one-119-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  // Extra structured data for this page, e.g. its FAQ.
  structuredData?: object[];
}

const { title, description, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL("/og-image.jpg", Astro.site).href;

const delaFace = `@font-face {
  font-family: "Dela Gothic One";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(${delaKana}) format("woff2");
  unicode-range: U+3041-309F;
}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#7cbdd9" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- How the link looks when shared on Discord, Facebook, WhatsApp and so on -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.searchName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Club members, several in cosplay, at a spring meetup in a Bristol park, with the club logo."
    />
    <meta name="twitter:card" content="summary_large_image" />

    <StructuredData extra={structuredData} />

    <link rel="preload" href={lilitaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={delaFace}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
